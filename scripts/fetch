#!/usr/bin/env bash
# fetch <owner/repo> <asset regex> <dir>: unpacks the asset of the repo's
# latest release whose name matches into dir.
set -euo pipefail
repo=$1 pattern=$2 dir=$3

# A token lifts the API's anonymous limit of 60 requests an hour.
token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
url=$(curl -fsSL ${token:+-H "Authorization: Bearer $token"} "https://api.github.com/repos/$repo/releases/latest" |
  jq -r --arg re "$pattern" 'first(.assets[] | select(.name | test($re))) | .browser_download_url')
if [ -z "$url" ]; then
  echo "fetch: no asset of $repo's latest release matches $pattern" >&2
  exit 1
fi
name=${url##*/}

rm -rf "$dir"
mkdir -p "$dir"
curl -fsSL -o "$dir/$name" "$url"
case $name in
  *.zip) unzip -q "$dir/$name" -d "$dir" && rm "$dir/$name" ;;
  *.tar.gz) tar -xzf "$dir/$name" -C "$dir" && rm "$dir/$name" ;;
esac
